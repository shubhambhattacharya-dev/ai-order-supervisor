# worker/.env — LLM gateway + tracing config
# Copy to worker/.env and fill in your own keys.

# PRIMARY — Groq (free tier). Get a key: https://console.groq.com/keys
GROQ_API_KEY=
LLM_PRIMARY_MODEL=openai/gpt-oss-120b

# FALLBACK 1 — tokenrouter (optional; the gateway skips missing keys safely)
# TOKENROUTER_API_KEY=
# TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
# TOKENROUTER_MODEL=z-ai/glm-5.3-free

# FALLBACK 2 — OpenRouter (optional; free pool)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free

# Postgres (defaults match docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=order_supervisor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Langfuse tracing (optional — leave empty to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
